# =========================================================================
# CChat Backend Environment Variables Example
# =========================================================================

# Database: Neon PostgreSQL Connection String
# (Make sure sslmode=require is included)
DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database>?sslmode=require

# Django Security & Debug Mode
# In production, set DEBUG=False and provide a strong random SECRET_KEY
DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-very-strong-secret-key-for-production

# Hostnames & Origins (Comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.now.sh
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

# Optional: Channels / Redis for real-time WebSocket communication
# (e.g. Upstash Redis, Redis Cloud, or local Redis)
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# Optional: Google OAuth Client ID
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
