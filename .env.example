# ==============================================================================
# CCHAT Environment Variables Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set DJANGO_DEBUG to False in production environments
DJANGO_DEBUG=False

# Cryptographically strong secret key (minimum 50 characters)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars-long

# Comma-separated list of valid Host header values
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# Database Connection URL (e.g. PostgreSQL, SQLite)
# PostgreSQL format: postgres://user:password@host:port/database_name
# SQLite format (default): sqlite:///backend/db.sqlite3
DATABASE_URL=postgres://cchat_user:cchat_secure_pass@localhost:5432/cchat_db

# --- CORS & ORIGIN SETTINGS ---
# Comma-separated list of allowed frontend origins (credentials permitted)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com

# --- PRODUCTION SECURITY HEADERS (Active when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- RATE LIMITING / THROTTLING ---
THROTTLE_ANON=120/minute
THROTTLE_USER=1000/minute
THROTTLE_REPORTS=10/hour
THROTTLE_INQUIRIES=10/hour
THROTTLE_PRIVACY=10/hour
THROTTLE_REACTIONS=240/minute
THROTTLE_MESSAGES=60/minute

# --- FRONTEND CLIENT SETTINGS ---
# Base API URL. Leave blank or use relative '/api' if reverse-proxied
VITE_API_URL=
