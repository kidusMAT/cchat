# ==============================================================================
# CCHAT Environment Variables Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
# Set DJANGO_DEBUG to False in production environments
DJANGO_DEBUG=False

# Cryptographically strong secret key (minimum 50 characters)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(50))'
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-chars-long

# Comma-separated list of valid Host header values
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# Database Connection URL for a local backend (e.g. PostgreSQL or SQLite).
# The Docker Compose stack constructs its own URL using the POSTGRES_* values below.
DATABASE_URL=postgres://cchat_user:replace-with-a-unique-database-password@localhost:5432/cchat_db

# Docker Compose PostgreSQL credentials. Use a unique password; never commit a real one.
POSTGRES_DB=cchat_db
POSTGRES_USER=cchat_user
POSTGRES_PASSWORD=replace-with-a-unique-database-password

# --- CORS & ORIGIN SETTINGS ---
# Comma-separated list of allowed frontend origins (credentials permitted)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com

# --- PRODUCTION SECURITY HEADERS (Active when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# --- GOOGLE OAUTH 2.0 SETTINGS ---
# Optional: Set all four variables to enable Google sign-in
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
FRONTEND_URL=http://localhost:5173

# --- RATE LIMITING / THROTTLING ---
THROTTLE_ANON=120/minute
THROTTLE_USER=1000/minute
THROTTLE_REPORTS=10/hour
THROTTLE_INQUIRIES=10/hour
THROTTLE_PRIVACY=10/hour
THROTTLE_REACTIONS=240/minute
THROTTLE_MESSAGES=60/minute

# --- FRONTEND CLIENT SETTINGS ---
# Base API URL. Leave blank or use relative '/api' if reverse-proxied
VITE_API_URL=

# Local preview only. Production builds never show demo-account sign-in.
VITE_ENABLE_DEMO_LOGIN=False
