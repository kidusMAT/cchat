# =========================================================================
# CChat Frontend Environment Variables Example
# =========================================================================

# Backend API base URL (Leave empty or '/' if deployed under the same monorepo domain on Vercel)
VITE_API_URL=http://localhost:8000

# WebSocket URL (optional, if using standalone real-time backend)
# VITE_WS_URL=ws://localhost:8000

# Google OAuth Client ID (optional)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
